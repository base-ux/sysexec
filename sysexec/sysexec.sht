#% ifndef _SYSEXEC_SHT
#% define _SYSEXEC_SHT	1

#% include "local.sht"
#% include "cmd.sht"
#% include "err.sht"

####

#% include "mklist.sht"
#% include "run_ssh.sht"

####

# Some checks
sysexec_check () {
    local shell=""

    # Check required files is set
    test -n "${W_HSTLIST}" || err "host list file is not set" || return 1
    test -n "${W_CMDLIST}" || err "command list file is not set" || return 1

    if test -n "${BEFORE_CMD}" || test -n "${AFTER_CMD}" ||
	test -n "${PREEXEC}" || test -n "${POSTEXEC}"
    then
	# Determine shell
	SH=""
	for shell in "/bin/sh" "/usr/bin/sh" "$(command -pv sh)" ; do
	    test -x "${shell}" && SH="${shell}" && break
	done
	test -n "${SH}" || err "'sh' executable not found" || return 1
    fi
}

# Create host and command lists
sysexec_mklist () {
    # Create host list
    MKLIST_TYPE="hst" \
    MKLIST_OUTFILE="${W_HSTLIST}" \
    mklist || return 1

    # Create command list
    MKLIST_TYPE="cmd" \
    MKLIST_OUTFILE="${W_CMDLIST}" \
    mklist || return 1

    # Check resulting files
    test -s "${W_HSTLIST}" || err "resulting host list is empty" || return 1
    test -s "${W_CMDLIST}" || err "resulting command list is empty" || return 1
}

# Run local command
sysexec_runcmd () {
    if test -n "$2" ; then
	"${SH}" -c "$2" || err "'$1' command returned nonzero status"
    fi
}

# Process 'user@host:port' entries
sysexec_set_host () {
    local host="$1"
    local user=""
    local port=""

    case "${host}" in
	( *'@'* ) user="${host%%@*}" ; host="${host#*@}" ;;
    esac
    case "${host}" in
	( *':'* ) port="${host##*:}" ; host="${host%:*}" ;;
    esac
    case "${host}" in
	( *[@:]* ) err "wrong formatted host entry '$1'" || return 1 ;;
    esac
    R_HOST="${host}"
    R_USER="${user:-"${DEF_USER}"}"
    R_PORT="${port:-22}"
}

# Process outfile patterns
sysexec_set_outfile () {
    local out="${OUTFILE}"

    while : ; do
	case "${out}" in
	    ( *'%h'* ) out="${out%%\%h*}${R_HOST}${out#*\%h}" ;;
	    ( *'%u'* ) out="${out%%\%u*}${R_USER}${out#*\%u}" ;;
	    ( * ) break ;;
	esac
    done
    RUN_SSH_OUTFILE="${out}"
}

# Process pre- and post-exec patterns
sysexec_set_prepost () {
    local type="$1"
    local res="$2"

    while : ; do
	case "${res}" in
	    ( *'%h'* ) res="${res%%\%h*}${R_HOST}${res#*\%h}" ;;
	    ( *'%u'* ) res="${res%%\%u*}${R_USER}${res#*\%u}" ;;
	    ( *'%o'* ) res="${res%%\%o*}${RUN_SSH_OUTFILE}${res#*\%o}" ;;
	    ( * ) break ;;
	esac
    done
    case "${type}" in
	( "pre" ) R_PREEXEC="${res}" ;;
	( "post" ) R_POSTEXEC="${res}" ;;
    esac
}

# Process host
sysexec_process_host () {
    case "$1" in
	( *[@:]* ) sysexec_set_host "$1" || return 1 ;;
	( * ) R_HOST="$1" ; R_USER="${DEF_USER}" ; R_PORT="22" ;;
    esac
    case "${OUTFILE}" in
	( *'%h'* | *'%u'* ) sysexec_set_outfile ;;
    esac
    case "${PREEXEC}" in
	( *'%h'* | *'%u'* | *'%o'* ) sysexec_set_prepost "pre" "${PREEXEC}" ;;
    esac
    case "${POSTEXEC}" in
	( *'%h'* | *'%u'* | *'%o'* ) sysexec_set_prepost "post" "${POSTEXEC}" ;;
    esac

    sysexec_runcmd "pre-exec" "${R_PREEXEC}" || return 1

    test -n "${VERBOSE}" && printf "%s\n" "${R_HOST}"

    # Set API variables and call run_ssh
    RUN_SSH_HOST="${R_HOST}"
    RUN_SSH_PORT="${R_PORT}"
    RUN_SSH_USER="${R_USER}"

    # Error status for run_ssh will be ignored
    if test -n "${G_OUTFILE}" ; then
	# Redirect output from run_ssh to global output file
	run_ssh >&3
    else
	# Otherwise the output will be redirected to stdout or
	# individual output file by run_ssh if OUTPUT is pattern
	run_ssh
    fi

    sysexec_runcmd "post-exec" "${R_POSTEXEC}" || return 1
}

# Some preprocess actions
sysexec_preprocess () {
    # Set invariants before cycle
    RUN_SSH_INFILE="${W_CMDLIST}"
    RUN_SSH_OUTFILE=""	# Will be set later
    case "${OUTFILE}" in
	( *'%h'* | *'%u'* ) ;;		# There are patterns in value
	( * ) G_OUTFILE="${OUTFILE}" ;;
    esac
    case "${PREEXEC}" in
	( *'%h'* | *'%u'* | *'%o'* ) ;;	# There are patterns in value
	( * ) R_PREEXEC="${PREEXEC}" ;;
    esac
    case "${POSTEXEC}" in
	( *'%h'* | *'%u'* | *'%o'* ) ;;	# There are patterns in value
	( * ) R_POSTEXEC="${POSTEXEC}" ;;
    esac

    # Open global output file
    case "${G_OUTFILE}" in ( '-' ) G_OUTFILE="" ;; esac
    if test -n "${G_OUTFILE}" ; then
	# Try to clear output file
	( : > "${G_OUTFILE}" ) 2>/dev/null ||
	    err "can't create output file '${G_OUTFILE}'" || return 1
	exec 3> "${G_OUTFILE}"	# Open output file as fd 3
    fi
}

# Some postprocess actions
sysexec_postprocess () {
    # Close global output file
    if test -n "${G_OUTFILE}" ; then
	exec 3>&-	# Close output file
    fi
}

# Execute commands at remote hosts
sysexec_process () {
    local host=""

    # Cycle through hosts
    while read host ; do
	sysexec_process_host "${host}"
    done < "${W_HSTLIST}"
}

# Main sysexec function
sysexec_main () {
    # Run some checks
    sysexec_check || return 1

    # Create host and command lists
    sysexec_mklist || return 1

    # Just print the resulting hosts list
    if test -n "${PRINT}" ; then
	cmd cat "${W_HSTLIST}"
	return 0
    fi

    sysexec_runcmd "before" "${BEFORE_CMD}" &&
	sysexec_preprocess &&
	sysexec_process &&
	sysexec_postprocess &&
	sysexec_runcmd "after" "${AFTER_CMD}"
}

# API function for sysexec
sysexec () {
    # Run the main function in a subshell to be able to override
    # global variables with the same names and redirect input/output
    (
	# Translate API variables
	W_HSTLIST="${SYSEXEC_HSTFILE}"
	W_CMDLIST="${SYSEXEC_CMDFILE}"
	HOSTLIST_GRP=""		# Run 'hostlist' in 'host' mode
	HOSTLIST_MASK="${SYSEXEC_MASK}"
	HOSTLIST_REGEX="${SYSEXEC_REGEX}"
	MKLIST_ARRAY="SYSEXEC_LIST"
	MKLIST_ELEMENTS="${SYSEXEC_LIST}"
	MKLIST_FPATH="${SYSEXEC_FPATH}"
	MKLIST_LPATH="${SYSEXEC_LPATH}"
	MKLIST_CPATH="${SYSEXEC_CPATH}"
	RUN_SSH_EXEC="${SYSEXEC_SSH}"
	RUN_SSH_CTLPATH="${SYSEXEC_CTLPATH}"
	RUN_SSH_OPTIONS="${SYSEXEC_SSHOPTS}"
	AFTER_CMD="${SYSEXEC_AFTER_CMD}"
	BEFORE_CMD="${SYSEXEC_BEFORE_CMD}"
	DEF_USER="${SYSEXEC_USER}"
	OUTFILE="${SYSEXEC_OUTFILE}"
	PREEXEC="${SYSEXEC_PREEXEC}"
	POSTEXEC="${SYSEXEC_POSTEXEC}"
	PRINT="${SYSEXEC_PRINT}"
	VERBOSE="${SYSEXEC_VERBOSE}"
	# Reset used variables
	R_HOST=""
	R_PORT=""
	R_USER=""
	R_PREEXEC=""
	R_POSTEXEC=""
	G_OUTFILE=""
	sysexec_main
    )
}
#% endif
