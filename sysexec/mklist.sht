#% ifndef _MKLIST_SHT
#% define _MKLIST_SHT	1

#% include "local.sht"
#% include "cmd.sht"
#% include "err.sht"
#% include "check_file.sht"
#% include "add_var.sht"
#% include "squote.sht"

####

#% include "hostlist.sht"

####

# Search file via XPATH directories
search_xpath () {
    local file="$1"
    local xpath="${XPATH}"
    local dir=""
    local found=""

    while test -n "${xpath}" ; do
	case "${xpath}" in
	    ( *':'* ) dir="${xpath%%:*}" ; xpath="${xpath#"${dir}:"}" ;;
	    ( * ) dir="${xpath}" ; xpath="" ;;
	esac
	case "${dir}" in
	    ( '~' ) dir="${HOME}" ;;
	    ( '~/'* ) dir="${HOME}/${dir#"~/"}" ;;
	esac
	test -n "${dir}" &&
	    test -f "${dir%/}/${file}" &&
	    found="true" &&
	    break	# Found
    done
    test -n "${found}" || return 1
    printf "%s" "${dir%/}/${file}"
}

# Search file
search_file () {
    local file="$1"

    test -n "${file}" || return 1
    test -f "${file}" ||	# Check file "as is"
    case "${file}" in
	( /* ) return 1 ;;	# Absolute path
	(  * ) file="$(search_xpath "${file}")" || return 1 ;;
    esac
    printf "%s" "${file}"
}

# Create list
mklist_process () {
    local e=""
    local v=""
    local file=""
    local list=""

    eval "set -- ${ELEMENTS}"
    for e in "$@" ; do
	case "${LISTTYPE}${e}" in
	    ( 'cmd'[EF]* | 'hst'[HL]* )
		eval "v=\"\${${ARRAY}_${e}}\""
		test -n "${v}" || continue	# Skip empty values
		;;
	    ( * ) continue ;;			# Skip other elements
	esac
	case "${LISTTYPE}${e}" in
	    ( 'cmdE'* | 'hstH'* ) printf "%s\n" "${v}" ;;
	    ( 'cmdF'* | 'hstL'* )
		case "${v}" in ( '-' ) continue ;; esac		# Skip stdin
		file="$(search_file "${v}")" || err "can't find file: ${v}" || return 1
		check_file "${file}" || err "can't open file: ${file}" || return 1
		case "${LISTTYPE}" in
		    ( 'cmd' ) cmd cat "${file}" ;;
		    ( 'hst' ) add_var "list" "$(squote "${file}")" ;;
		esac
		;;
	esac
    done
    if test -n "${list}" ; then
	eval "set -- ${list}"
	hostlist "$@"
    fi
}

# Main mklist function
mklist_main () {
    local rc=0	# Return code

    # Set XPATH variable
    case "${LISTTYPE}" in
	( 'cmd' ) XPATH="${CMDLIST_PATH}" ;;
	( 'hst' ) XPATH="${HSTLIST_PATH}" ;;
	( * ) err "unknown list type '${LISTTYPE}'" || return 1 ;;
    esac
    test -n "${COMMON_PATH}" && add_var "XPATH" "${COMMON_PATH}" ':'

    # Open file descriptors
    case "${OUTFILE}" in ( '-' ) OUTFILE="" ;; esac
    if test -n "${OUTFILE}" ; then
	# If output file is set then try to create it
	( : > "${OUTFILE}" ) 2>/dev/null ||
	    err "can't create output file '${OUTFILE}'" || return 1
	exec 1> "${OUTFILE}"	# Open output file
    fi

    # Create list
    mklist_process || rc=$?

    # Close file descriptors
    test -n "${OUTFILE}" && exec 1>&-

    return ${rc}
}

# API function for mklist
mklist () {
    # Run the main function in a subshell to be able to override
    # global variables with the same names and redirect input/output
    (
	# Translate API variables to internal names
	LISTTYPE="${MKLIST_TYPE}"
	OUTFILE="${MKLIST_OUTFILE}"
	ARRAY="${MKLIST_ARRAY}"
	ELEMENTS="${MKLIST_ELEMENTS}"
	CMDLIST_PATH="${MKLIST_FPATH}"
	HSTLIST_PATH="${MKLIST_LPATH}"
	COMMON_PATH="${MKLIST_CPATH}"
	mklist_main
    )
}
#% endif
