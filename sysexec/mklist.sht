#% ifndef _MKLIST_SHT
#% define _MKLIST_SHT	1

#% include "local.sht"
#% include "cmd.sht"
#% include "err.sht"
#% include "check_file.sht"
#% include "add_to_var.sht"
#% include "squote.sht"

#% include "hostlist.sht"

# Search file via XPATH directories
search_xpath () {
    local file="$1"
    local xpath="${XPATH}"
    local dir=""
    local found=""

    while test -n "${xpath}" ; do
	case "${xpath}" in
	    ( *':'* ) dir="${xpath%%:*}" ; xpath="${xpath#"${dir}:"}" ;;
	    ( * ) dir="${xpath}" ; xpath="" ;;
	esac
	case "${dir}" in
	    ( '~' ) dir="${HOME}" ;;
	    ( '~/'* ) dir="${HOME}/${dir#"~/"}" ;;
	esac
	test -n "${dir}" &&
	    test -f "${dir%/}/${file}" &&
	    found="true" &&
	    break	# Found
    done
    test -n "${found}" || return 1
    printf "%s" "${dir%/}/${file}"
}

# Search file
search_file () {
    local file="$1"

    test -n "${file}" || return 1
    test -f "${file}" ||	# Check file "as is"
    case "${file}" in
	( /* ) return 1 ;;	# Absolute path
	(  * ) file="$(search_xpath "${file}")" || return 1 ;;
    esac
    printf "%s" "${file}"
}

# Main mkcmdlist function
mkcmdlist () {
    local e=""
    local v=""
    local file=""

    eval "set -- ${CMDLIST}"
    for e in "$@" ; do
	case "${e}" in
	    ( [!EF]* | [EF] | [EF]*[!0-9]* ) continue ;;	# Skip garbage
	esac
	eval "v=\"\${${VPREFIX}_${e}}\""
	test -n "${v}" || continue				# Skip empty values
	case "${e}" in
	    ( 'E'* ) printf "%s\n" "${v}" ;;
	    ( 'F'* )
		case "${v}" in ( '-' ) continue ;; esac		# Skip stdin
		file="$(search_file "${v}")" || err "can't find file: ${v}" || return 1
		check_file "${file}" && cmd cat "${file}" ||
		    err "can't open file: ${file}" || return 1
		;;
	esac
    done
}

# Main mkhstlist function
mkhstlist () {
    local e=""
    local v=""
    local list=""
    local file=""

    eval "set -- ${HSTLIST}"
    for e in "$@" ; do
	case "${e}" in
	    ( [!HL]* | [HL] | [HL]*[!0-9]* ) continue ;;	# Skip garbage
	esac
	eval "v=\"\${${VPREFIX}_${e}}\""
	test -n "${v}" || continue				# Skip empty values
	case "${e}" in
	    ( 'H'* ) printf "%s\n" "${v}" ;;
	    ( 'L'* )
		case "${v}" in ( '-' ) continue ;; esac		# Skip stdin
		file="$(search_file "${v}")" || err "can't find file: ${v}" || return 1
		check_file "${file}" || err "can't open file: ${file}" || return 1
		add_to_var "list" "$(squote "${file}")"
		;;
	esac
    done
    if test -n "${list}" ; then
	# Reset 'hostlist' mode to 'host'
	# Other 'hostlist' variables is set by main 'sysexec' script
	HOSTLIST_GRP=""
	eval "set -- ${list}"
	hostlist "$@"
    fi
}

# Create list
mklist_main () {
    local rc=0	# Return code

    case "${LISTTYPE}" in
	( 'cmd' ) test -n "${CMDLIST}" || err "command list is not set" ;;
	( 'hst' ) test -n "${HSTLIST}" || err "host list is not set" ;;
	( * ) err "unknown list type '${LISTTYPE}'" ;;
    esac || return 1

    case "${OUTFILE}" in ( '-' ) OUTFILE="" ;; esac
    if test -n "${OUTFILE}" ; then
	# If output file is set then try to create it
	( : > "${OUTFILE}" ) 2>/dev/null ||
	    err "can't create output file '${OUTFILE}'" || return 1
	exec 1> "${OUTFILE}"	# Open output file
    fi

    # Set XPATH variable
    case "${LISTTYPE}" in
	( 'cmd' ) XPATH="${CMDLIST_PATH}" ;;
	( 'hst' ) XPATH="${HSTLIST_PATH}" ;;
    esac
    test -n "${COMMON_PATH}" && add_to_var "XPATH" "${COMMON_PATH}" ':'

    # Call main function
    "mk${LISTTYPE}list" || rc=$?

    # Close file descriptors
    test -n "${OUTFILE}" && exec 1>&-

    return ${rc}
}

# API function for mklist
mklist () {
    # Run the main function in a subshell to be able to override
    # global variables with the same names and redirect input/output
    (
	# Translate API variables to internal names
	LISTTYPE="${MKLIST_TYPE}"
	OUTFILE="${MKLIST_OUTFILE}"
	CMDLIST="${MKLIST_CMDLIST}"
	HSTLIST="${MKLIST_HSTLIST}"
	CMDLIST_PATH="${MKLIST_FPATH}"
	HSTLIST_PATH="${MKLIST_LPATH}"
	COMMON_PATH="${MKLIST_CPATH}"
	VPREFIX="${MKLIST_VPREFIX}"
	mklist_main
    )
}
#% endif
