#% include "local.sht"
#% include "cmd.sht"
#% include "err.sht"
#% include "check_file.sht"

################

# Execute command and discard stderr
cmd () {
    command ${1+"$@"} 2>/dev/null
}

# Print error message and return non-zero status
err () {
    ! printf "%s: error: %s\n" "${PROG:-"$0"}" "$*" >&2
}

# Check if $1 is readable file
check_file () {
    test -f "$1" && test -r "$1" || return 1
}

################

# Main mkcmdlist function
mkcmdlist () {
    local e=""
    local v=""

    eval "set -- ${CMDLIST}"
    for e in "$@" ; do
	case "${e}" in
	    ( [!EF]* | [EF] | [EF]*[!0-9]* ) continue ;;	# Skip garbage
	esac
	eval "v=\"\${CMDLIST_${e}}\""
	test -n "${v}" || continue	# Skip empty values
	case "${e}" in
	    ( 'E'* ) printf "%s\n" "${v}" ;;
	    ( 'F'* )
		check_file "${v}" && cmd cat "${v}" ||
		    err "can't open file: ${v}" || return 1
		;;
	esac
    done
}

# Main mkhstlist function
mkhstlist () {
    local e=""
    local v=""

    eval "set -- ${HSTLIST}"
    for e in "$@" ; do
	case "${e}" in
	    ( [!HL]* | [HL] | [HL]*[!0-9]* ) continue ;;	# Skip garbage
	esac
	eval "v=\"\${HSTLIST_${e}}\""
	test -n "${v}" || continue	# Skip empty values
	case "${e}" in
	    ( 'H'* ) printf "%s\n" "${v}" ;;
	    ( 'L'* )
		check_file "${v}" && cmd cat "${v}" ||
		    err "can't open file: ${v}" || return 1
		;;
	esac
    done
}

# Create list
# $1 is type of list
# $2 is output file
mklist () {
    case "$1" in
	( 'cmd' ) test -n "${CMDLIST}" || err "command list is not set" ;;
	( 'hst' ) test -n "${HSTLIST}" || err "host list is not set" ;;
	( * ) err "unknown list type" ;;
    esac || return 1
    # Run the main function in a subshell to be able to override
    # global variables with the same names and redirect input/output
    (
	rc=0	# Return code
	OUTFILE="$2"
	case "${OUTFILE}" in ( '-' ) OUTFILE="" ;; esac
	if test -n "${OUTFILE}" ; then
	    # If output file is set then try to create it
	    ( : > "${OUTFILE}" ) 2>/dev/null ||
		err "can't create output file '${OUTFILE}'" || return 1
	    exec 1> "${OUTFILE}"	# Open output file
	fi

	# Call main function
	case "$1" in
	    ( 'cmd' ) mkcmdlist ;;
	    ( 'hst' ) mkhstlist ;;
	esac || rc=$?

	# Close file descriptors
	test -n "${OUTFILE}" && exec 1>&-

	return ${rc}
    )
}

################

main () {
    mklist "$@"
}

main "$@"
