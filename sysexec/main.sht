#!/bin/sh

# Program name
PROG="${0##*/}"

#% include "local.sht"
#% include "cmd.sht"
#% include "err.sht"
#% include "add_to_var.sht"

####

# Print usage information
usage () {
    ! cat << EOF
Usage: ${PROG} [options] [-u user] [-h host]... [-l listfile]...
	{ [-e command]... [-f cmdfile]... | command }
EOF
}

# Print help information
usage_help () {
    usage
    cat << EOF

    Execute commands on remote host

    Main options:
    -u user	user to login to the hosts (default: current user)
    -h host	host where the commands to be executed
    -l listfile	file with the list of hosts where the commands to be executed
    -e command	command to be executed on the hosts
    -f cmdfile	file with the list of commands to be executed on the hosts

    Either combination of '-h' and '-l' flags should be set.
    Either combination of '-e' and '-f' flags or just 'command' should be set.

    Other options:
    -C path	common search path for 'listfile' and 'cmdfile' (colon separated)
    -F path	search path for 'cmdfile' (colon separated)
    -L path	search path for 'listfile' (colon separated)
    -B before	command to execute before processing
    -A after	command to execute after processing
    -m mask	filter hosts from host list by mask
    -r regex	filter hosts from host list by regular expression
    -q		print the resulting list of hosts (no commands execution)
    -v		print host name before execution
EOF
    exit 0
}

####

# $1 list variable name
# $2 marker for list
# $3 value
add_to_list () {
    eval "${SYSEXEC_VPREFIX}_$2=\"$3\""
    add_to_var "$1" "$2"
}

# Parse command line options
get_options () {
    local opt=""

    case "$1" in ( '-?' | '-help' | '--help' ) usage_help ;; esac
    while getopts ":A:B:C:F:L:e:f:h:l:m:qr:u:v" opt ; do
	case "${opt}" in
	    ( 'A' ) SYSEXEC_AFTER_CMD="${OPTARG}" ;;
	    ( 'B' ) SYSEXEC_BEFORE_CMD="${OPTARG}" ;;
	    ( 'C' ) add_to_var "SYSEXEC_CPATH" "${OPTARG}" ':' ;;
	    ( 'F' ) add_to_var "SYSEXEC_FPATH" "${OPTARG}" ':' ;;
	    ( 'L' ) add_to_var "SYSEXEC_LPATH" "${OPTARG}" ':' ;;
	    ( 'e' ) add_to_list "SYSEXEC_CMDLIST" "E${OPTIND}" "${OPTARG}" ;;
	    ( 'f' ) add_to_list "SYSEXEC_CMDLIST" "F${OPTIND}" "${OPTARG}" ;;
	    ( 'h' ) add_to_list "SYSEXEC_HSTLIST" "H${OPTIND}" "${OPTARG}" ;;
	    ( 'l' ) add_to_list "SYSEXEC_HSTLIST" "L${OPTIND}" "${OPTARG}" ;;
	    ( 'm' ) add_to_var "SYSEXEC_MASK" "${OPTARG}" '\\n' ;;
	    ( 'q' ) SYSEXEC_PRINT="true" ;;
	    ( 'r' ) add_to_var "SYSEXEC_REGEX" "${OPTARG}" '\\n' ;;
	    ( 'u' ) SYSEXEC_USER="${OPTARG}" ;;
	    ( 'v' ) SYSEXEC_VERBOSE="true" ;;
	    ( ':' ) err "missing argument for option -- '${OPTARG}'" || usage ;;
	    ( '?' ) err "unknown option -- '${OPTARG}'" || usage ;;
	    (  *  ) err "no handler for option '${opt}'" ;;
	esac || return 1
    done
    shift $(( OPTIND - 1 ))
    if test -n "$*" ; then
	test -z "${SYSEXEC_CMDLIST}" ||
	    err "'-e' and '-f' options are mutually exclusive with 'command'" ||
	    return 1
	add_to_list "SYSEXEC_CMDLIST" "E${OPTIND}" "$*"
    fi
}

####

#% include "sysexec.sht"

####

# Initialization subroutine
init () {
    # Some common variables
    : "${RANDOM:=$(cmd date +%s)}"	# Workaround for dash
    : "${XDG_STATE_HOME:="${HOME}/.local/state"}"
    SSH="$(command -v ssh)"

    # Working directory and files
    WORKDIR="${XDG_STATE_HOME}/sysexec"
    SYSEXEC_CMDFILE="${WORKDIR}/cmdlist.${RANDOM}.$$"
    SYSEXEC_HSTFILE="${WORKDIR}/hstlist.${RANDOM}.$$"
    SYSEXEC_VPREFIX="SYSEXEC_LIST"

    # Variables for 'hostlist'
    SYSEXEC_MASK=""
    SYSEXEC_REGEX=""

    # Variables for 'mklist'
    SYSEXEC_CMDLIST=""
    SYSEXEC_HSTLIST=""
    SYSEXEC_FPATH=""
    SYSEXEC_LPATH=""
    SYSEXEC_CPATH=""

    # Defaults
    SYSEXEC_AFTER_CMD=""
    SYSEXEC_BEFORE_CMD=""
    SYSEXEC_PRINT=""
    SYSEXEC_USER="${USER:-$(cmd id -un)}"
    SYSEXEC_VERBOSE=""
}

# Startup subroutine
startup () {
    # Check 'ssh' executable
    test -n "${SSH}" || err "'ssh' executable not found" || return 1

    # Check user
    test -n "${SYSEXEC_USER}" || err "empty user name is set" || return 1

    # Check host list
    test -n "${SYSEXEC_HSTLIST}" || err "neither 'host' nor 'listfile' are set" || return 1

    # Check command list
    test -n "${SYSEXEC_CMDLIST}" || err "neither 'command' nor 'cmdfile' are set" || return 1

    # Try to create working directory
    test -d "${WORKDIR}" || ( umask 0077 ; cmd mkdir -p "${WORKDIR}" ) ||
	err "can't create working directory" || return 1
}

# Clean up the staff
cleanup () {
    cmd rm -f "${SYSEXEC_CMDFILE}" "${SYSEXEC_HSTFILE}"
}

# Clean up the staff and exit with error
clean_fail () {
    cleanup
    fail "${1:-1}"
}

# Exit with error code
fail () {
    exit "${1:-1}"
}

####

# Main subroutine
main () {
    init && get_options "$@" && startup || fail
    trap 'clean_fail 130' HUP INT TERM
    sysexec || clean_fail
    cleanup
}

# Call main subroutine
main "$@"
